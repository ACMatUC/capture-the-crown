{
  "name": "capture-the-crown",
  "version": "1.0.0",
  "description": "A LAN multiplayer game for ACM@UC networking workshops.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/server.ts",
    "start": "tsx server/server.ts",
    "start:built": "node dist/server/server.js",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json && node scripts/verify-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run --exclude tests/lan.test.ts",
    "test:watch": "vitest --exclude tests/lan.test.ts",
    "test:lan": "vitest run tests/lan.test.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:lan && npm run build"
  },
  "license": "MIT",
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
